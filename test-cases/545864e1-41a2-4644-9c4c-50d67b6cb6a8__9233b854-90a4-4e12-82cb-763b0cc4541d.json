{
  "id": "9233b854-90a4-4e12-82cb-763b0cc4541d",
  "testPlanId": "545864e1-41a2-4644-9c4c-50d67b6cb6a8",
  "requirementId": "432a0d61-c539-42f9-a780-50a0d7c9d535",
  "suiteName": "Save Customer - E2E",
  "case": {
    "id": "9233b854-90a4-4e12-82cb-763b0cc4541d",
    "title": "Correct mistyped fields using clear then save and validate",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to Sales details URL",
        "value": "https://s-dev-ukg.sandbox.operations.dynamics.com/?cross-company=true&cmp=1001&mi=SalesTableDetails"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Click Modules",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clickBefore"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click Accounts receivable",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clickAccountsReceivable"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click All customers",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clickAllCustomers"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Click New",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clickNew"
      },
      {
        "id": "s6",
        "action": "fill",
        "targetDescription": "Type wrong Customer account 'wrong1'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillDynamicHeaderAccountNum",
        "value": "wrong1"
      },
      {
        "id": "s7",
        "action": "clear",
        "targetDescription": "Clear Customer account",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clearDynamicHeaderAccountNum"
      },
      {
        "id": "s8",
        "action": "fill",
        "targetDescription": "Fill corrected Customer account 'clear001'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillDynamicHeaderAccountNum",
        "value": "clear001"
      },
      {
        "id": "s9",
        "action": "fill",
        "targetDescription": "Type wrong Name 'Wrong Name'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillOrgName",
        "value": "Wrong Name"
      },
      {
        "id": "s10",
        "action": "clear",
        "targetDescription": "Clear Name",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clearOrgName"
      },
      {
        "id": "s11",
        "action": "fill",
        "targetDescription": "Fill corrected Name 'Clear Correct'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillOrgName",
        "value": "Clear Correct"
      },
      {
        "id": "s12",
        "action": "fill",
        "targetDescription": "Type wrong Customer group 'wronggroup'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillDynamicDetailCustGroup",
        "value": "wronggroup"
      },
      {
        "id": "s13",
        "action": "clear",
        "targetDescription": "Clear Customer group",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clearDynamicDetailCustGroup"
      },
      {
        "id": "s14",
        "action": "fill",
        "targetDescription": "Fill corrected Customer group 'test'",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "fillDynamicDetailCustGroup",
        "value": "test"
      },
      {
        "id": "s15",
        "action": "assertEnabled",
        "targetDescription": "Verify Save is enabled after corrections",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "expectSaveEnabled"
      },
      {
        "id": "s16",
        "action": "tap",
        "targetDescription": "Click Save",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "clickSave"
      },
      {
        "id": "s17",
        "action": "assertValue",
        "targetDescription": "Validate saved Customer account value",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "expectDynamicHeaderAccountNumValue",
        "assertion": "clear001"
      },
      {
        "id": "s18",
        "action": "assertValue",
        "targetDescription": "Validate saved Name value",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "expectOrgNameValue",
        "assertion": "Clear Correct"
      },
      {
        "id": "s19",
        "action": "assertValue",
        "targetDescription": "Validate saved Customer group value",
        "screenName": "AllCustomersFinanceAndOperationsPage",
        "pageObjectMethod": "expectDynamicDetailCustGroupValue",
        "assertion": "test"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
